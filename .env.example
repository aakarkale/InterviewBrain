# Copy to .env.local and fill in. Never commit .env files.

# Neon Data API (PostgREST-compatible). Server-side only.
NEON_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/neondb/rest/v1

# Neon Auth (Managed Better Auth).
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# Signs the session cookie. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

ANTHROPIC_API_KEY=
RESEND_API_KEY=
